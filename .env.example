# Copy this file to .env in the repository root and fill in real values.
# Every variable here corresponds 1:1 to a field in backend/config/settings.py.

# ── Environment ───────────────────────────────────────────────────────────
ENVIRONMENT=development
API_VERSION=v1

# ── Database (MySQL) ──────────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace_with_your_mysql_password
MYSQL_DATABASE=ecommerce
MYSQL_TEST_DATABASE=ecommerce_test
SQL_ECHO=false

# ── JWT Authentication ────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_string_min_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_MINUTES=10080

# ── Frontend & CORS ───────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5500
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# Required in production (ENVIRONMENT=production) — TrustedHostMiddleware rejects any request
# whose Host header isn't in this list. Comma-separated, no scheme/port.
TRUSTED_HOSTS=yourdomain.com,www.yourdomain.com

# ── Security ───────────────────────────────────────────────────────────────
DOCS_ENABLED=false
COOKIE_SECURE=true

# ── Deployment ────────────────────────────────────────────────────────────
# Must match how many worker processes actually launch the app (see README "Deployment") — the
# in-memory cache/rate-limiter are not shared across workers.
WEB_CONCURRENCY=1

# ── Cache ─────────────────────────────────────────────────────────────────
CACHE_MAX_ENTRIES=5000

# ── Rate Limiting (requests/minute) ──────────────────────────────────────
RATE_LOGIN=5/minute
RATE_REGISTER=3/minute
RATE_ORDER=10/minute
RATE_GENERAL=60/minute

# ── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ── Payments ──────────────────────────────────────────────────────────────
# Every gateway below defaults to disabled — the app runs fully on Cash on Delivery with none
# of these set. Flip a gateway's *_ENABLED to true only once you've filled in real credentials;
# the app fails fast on boot otherwise (see backend/config/settings.py).
PAYMENT_CURRENCY=PKR

STRIPE_ENABLED=false
STRIPE_SECRET_KEY=replace_with_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=replace_with_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=replace_with_your_stripe_webhook_secret

# JazzCash Hosted Checkout Page — https://sandbox.jazzcash.com.pk (sandbox) once you have a
# merchant account; JAZZCASH_INTEGRITY_SALT signs every request/callback. The return URL points
# at this backend (GET/POST /payments/return/jazzcash), not the frontend directly — that route
# is a UX-only "thank you page" redirect to the frontend's tracking page, never proof of payment.
JAZZCASH_ENABLED=false
JAZZCASH_MERCHANT_ID=replace_with_your_jazzcash_merchant_id
JAZZCASH_PASSWORD=replace_with_your_jazzcash_password
JAZZCASH_INTEGRITY_SALT=replace_with_your_jazzcash_integrity_salt
JAZZCASH_SANDBOX=true
JAZZCASH_RETURN_URL=http://localhost:8000/payments/return/jazzcash

# EasyPaisa hosted checkout — store ID + hash key come from the EasyPaisa merchant portal. Same
# backend-return-URL note as JazzCash above.
EASYPAISA_ENABLED=false
EASYPAISA_STORE_ID=replace_with_your_easypaisa_store_id
EASYPAISA_HASH_KEY=replace_with_your_easypaisa_hash_key
EASYPAISA_SANDBOX=true
EASYPAISA_RETURN_URL=http://localhost:8000/payments/return/easypaisa

# ── Seed data (backend/seed/seed_admin.py only) ──────────────────────────
# Used only to create local demo admin accounts; not read by the app itself.
SEED_SUPERADMIN_PASSWORD=replace_with_a_strong_password
SEED_ADMIN_PASSWORD=replace_with_a_strong_password
SEED_MANAGER_PASSWORD=replace_with_a_strong_password
SEED_SUPPORT_PASSWORD=replace_with_a_strong_password
